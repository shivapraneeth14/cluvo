# Flutter uses --dart-define for env vars at BUILD time.
# There are no defaults in source code — a build without these defines
# refuses to start (see lib/config.dart ensureConfigured, docs/ENV.md).
#
# Local run (recommended):   ./scripts/run.sh [test|prod]
# Print exact command:       ./scripts/switch-supabase.sh <test|prod>
#
# Raw command:
#   flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=... \
#     --dart-define=CLOUDINARY_CLOUD_NAME=... --dart-define=CLOUDINARY_UPLOAD_PRESET=... \
#     [--dart-define=RAZORPAY_KEY_ID=...]

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
RAZORPAY_KEY_ID=
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-upload-preset
